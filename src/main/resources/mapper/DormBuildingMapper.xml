<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.studentlife.repair.module.dorm_building.mapper.DormBuildingMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND dormBuilding.id = #{entity.id}
            </if>
            <if test="entity.buildingName != null and entity.buildingName != ''">
                AND dormBuilding.building_name LIKE CONCAT('%', #{entity.buildingName}, '%')
            </if>
            <if test="entity.buildingNo != null and entity.buildingNo != ''">
                AND dormBuilding.building_no LIKE CONCAT('%', #{entity.buildingNo}, '%')
            </if>
            <if test="entity.roomType != null">
                AND dormBuilding.room_type = #{entity.roomType}
            </if>
            <if test="entity.status != null">
                AND dormBuilding.status = #{entity.status}
            </if>
            <if test="entity.realName != null and entity.realName != ''">
                AND sysUser.real_name LIKE CONCAT('%', #{entity.realName}, '%')
            </if>
            <if test="entity.managerUserId != null">
                AND dormBuilding.manager_user_id = #{entity.managerUserId}
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.studentlife.repair.module.dorm_building.entity.DormBuilding">
        SELECT dormBuilding.*
        , sysUser.real_name AS realName
        FROM dorm_building dormBuilding
        LEFT JOIN sys_user sysUser ON dormBuilding.manager_user_id = sysUser.id
        <include refid="whereCondition"/>
        ORDER BY dormBuilding.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM dorm_building dormBuilding
        LEFT JOIN sys_user sysUser ON dormBuilding.manager_user_id = sysUser.id
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.studentlife.repair.module.dorm_building.entity.DormBuilding">
        SELECT dormBuilding.*
        , sysUser.real_name AS realName
        FROM dorm_building dormBuilding
        LEFT JOIN sys_user sysUser ON dormBuilding.manager_user_id = sysUser.id
        <include refid="whereCondition"/>
        ORDER BY dormBuilding.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.studentlife.repair.module.dorm_building.entity.DormBuilding">
        SELECT dormBuilding.*
        , sysUser.real_name AS realName
        FROM dorm_building dormBuilding
        LEFT JOIN sys_user sysUser ON dormBuilding.manager_user_id = sysUser.id
        WHERE dormBuilding.id = #{id}
    </select>

</mapper>
