<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.studentlife.repair.module.material.mapper.MaterialMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND material.id = #{entity.id}
            </if>
            <if test="entity.materialName != null and entity.materialName != ''">
                AND material.material_name LIKE CONCAT('%', #{entity.materialName}, '%')
            </if>
            <if test="entity.materialCode != null and entity.materialCode != ''">
                AND material.material_code LIKE CONCAT('%', #{entity.materialCode}, '%')
            </if>
            <if test="entity.materialType != null">
                AND material.material_type = #{entity.materialType}
            </if>
            <if test="entity.status != null">
                AND material.status = #{entity.status}
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.studentlife.repair.module.material.entity.Material">
        SELECT material.*
        FROM material material
        <include refid="whereCondition"/>
        ORDER BY material.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM material material
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.studentlife.repair.module.material.entity.Material">
        SELECT material.*
        FROM material material
        <include refid="whereCondition"/>
        ORDER BY material.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.studentlife.repair.module.material.entity.Material">
        SELECT material.*
        FROM material material
        WHERE material.id = #{id}
    </select>

</mapper>
